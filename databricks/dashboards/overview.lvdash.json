{
  "datasets": [
    {
      "name": "headline_counts",
      "displayName": "Headline counts",
      "queryLines": [
        "SELECT\n",
        "  count(*) AS users_tracked,\n",
        "  count_if(verdict IN ('bot', 'likely-bot')) AS bot_side_verdicts,\n",
        "  count_if(user_status IN ('suspended', 'deleted')) AS gone_accounts\n",
        "FROM silver.users\n"
      ]
    },
    {
      "name": "verdict_distribution",
      "displayName": "Verdict distribution",
      "queryLines": [
        "SELECT verdict, count(*) AS users\n",
        "FROM silver.users\n",
        "WHERE verdict IS NOT NULL\n",
        "GROUP BY verdict\n"
      ]
    },
    {
      "name": "recent_confirmed_bots",
      "displayName": "Recent confirmed bots",
      "queryLines": [
        "SELECT\n",
        "  username AS `Username`,\n",
        "  initcap(replace(persona_label, '_', ' ')) AS `Persona`,\n",
        "  initcap(user_status) AS `Status`,\n",
        "  date_format(investigated_at, 'MMM d, yyyy') AS `Detected`\n",
        "FROM silver.users\n",
        "WHERE verdict IN ('bot', 'likely-bot')\n",
        "  AND user_status IN ('deleted', 'suspended')\n",
        "ORDER BY investigated_at DESC\n",
        "LIMIT 10\n"
      ]
    },
    {
      "name": "persona_distribution",
      "displayName": "Persona distribution",
      "queryLines": [
        "SELECT persona_label, count(*) AS users\n",
        "FROM silver.users\n",
        "WHERE persona_label IS NOT NULL\n",
        "GROUP BY persona_label\n"
      ]
    },
    {
      "name": "verdict_outcomes",
      "displayName": "Verdict outcomes",
      "queryLines": [
        "SELECT verdict, user_status, count(*) AS users\n",
        "FROM silver.users\n",
        "WHERE verdict IS NOT NULL AND user_status IS NOT NULL\n",
        "GROUP BY verdict, user_status\n"
      ]
    },
    {
      "name": "reports_weekly",
      "displayName": "Reports per week",
      "queryLines": [
        "SELECT date_trunc('week', reported_at) AS week, count(*) AS reports\n",
        "FROM silver.report_events\n",
        "GROUP BY week\n"
      ]
    },
    {
      "name": "top_reported_subreddits",
      "displayName": "Top reported subreddits",
      "queryLines": [
        "SELECT subreddit, count(*) AS reports\n",
        "FROM silver.report_events\n",
        "WHERE subreddit IS NOT NULL\n",
        "GROUP BY subreddit\n",
        "ORDER BY reports DESC\n",
        "LIMIT 10\n"
      ]
    },
    {
      "name": "region_verdict_mix",
      "displayName": "Verdict mix by region",
      "queryLines": [
        "SELECT region_code,\n",
        "  stack(3,\n",
        "    'bot-side', bot_side,\n",
        "    'uncertain', uncertain,\n",
        "    'human-side', human_side) AS (side, users)\n",
        "FROM gold.region_verdicts\n",
        "WHERE users >= 10\n"
      ]
    },
    {
      "name": "region_bot_rate",
      "displayName": "Bot rate by region",
      "queryLines": [
        "SELECT region_code, round(bot_rate * 100, 0) AS bot_pct\n",
        "FROM gold.region_verdicts\n",
        "WHERE users >= 10\n"
      ]
    },
    {
      "name": "bot_account_subreddits",
      "displayName": "Subreddits with most bot accounts",
      "queryLines": [
        "SELECT subreddit, bot_accounts\n",
        "FROM gold.subreddit_bot_share\n",
        "ORDER BY bot_accounts DESC\n",
        "LIMIT 12\n"
      ]
    },
    {
      "name": "bot_saturated_subreddits",
      "displayName": "Most bot-saturated subreddits",
      "queryLines": [
        "SELECT\n",
        "  concat('r/', subreddit) AS `Subreddit`,\n",
        "  tracked_users AS `Tracked users`,\n",
        "  bot_accounts AS `Bot accounts`,\n",
        "  concat(cast(round(bot_share * 100, 0) AS int), '%') AS `Bot share`\n",
        "FROM gold.subreddit_bot_share\n",
        "WHERE tracked_users >= 15\n",
        "ORDER BY bot_share DESC\n",
        "LIMIT 15\n"
      ]
    },
    {
      "name": "region_bot_subreddits",
      "displayName": "Where each region's bots post",
      "queryLines": [
        "WITH ranked AS (\n",
        "  SELECT users.region_code, events.subreddit,\n",
        "    count(DISTINCT events.username) AS bot_accounts,\n",
        "    ROW_NUMBER() OVER (\n",
        "      PARTITION BY users.region_code\n",
        "      ORDER BY count(DISTINCT events.username) DESC, events.subreddit\n",
        "    ) AS rank\n",
        "  FROM silver.activity_events events\n",
        "  JOIN silver.users users USING (username)\n",
        "  WHERE users.verdict IN ('bot', 'likely-bot')\n",
        "    AND users.region_code IS NOT NULL\n",
        "    AND events.subreddit IS NOT NULL\n",
        "  GROUP BY users.region_code, events.subreddit\n",
        ")\n",
        "SELECT\n",
        "  region_code AS `Region`,\n",
        "  concat('r/', subreddit) AS `Subreddit`,\n",
        "  bot_accounts AS `Bot accounts`\n",
        "FROM ranked\n",
        "WHERE rank <= 5\n",
        "  AND region_code IN (SELECT region_code FROM gold.region_verdicts WHERE bot_side >= 5)\n",
        "ORDER BY `Region`, `Bot accounts` DESC\n"
      ]
    }
  ],
