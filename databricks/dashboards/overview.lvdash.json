{
  "datasets": [
    {
      "name": "headline_counts",
      "displayName": "Headline counts",
      "queryLines": [
        "SELECT\n",
        "  count(*) AS users_tracked,\n",
        "  count_if(verdict IN ('bot', 'likely-bot')) AS bot_side_verdicts,\n",
        "  count_if(user_status IN ('suspended', 'deleted')) AS gone_accounts\n",
        "FROM silver.users\n"
      ]
    },
    {
      "name": "verdict_distribution",
      "displayName": "Verdict distribution",
      "queryLines": [
        "SELECT verdict, count(*) AS users\n",
        "FROM silver.users\n",
        "WHERE verdict IS NOT NULL\n",
        "GROUP BY verdict\n"
      ]
    },
    {
      "name": "recent_confirmed_bots",
      "displayName": "Recent confirmed bots",
      "queryLines": [
        "SELECT username, verdict, round(bot_probability, 2) AS bot_probability,\n",
        "  persona_label, user_status, investigated_at\n",
        "FROM silver.users\n",
        "WHERE verdict IN ('bot', 'likely-bot')\n",
        "  AND user_status IN ('deleted', 'suspended')\n",
        "ORDER BY investigated_at DESC\n",
        "LIMIT 10\n"
      ]
    },
    {
      "name": "persona_distribution",
      "displayName": "Persona distribution",
      "queryLines": [
        "SELECT persona_label, count(*) AS users\n",
        "FROM silver.users\n",
        "WHERE persona_label IS NOT NULL\n",
        "GROUP BY persona_label\n"
      ]
    },
    {
      "name": "verdict_outcomes",
      "displayName": "Verdict outcomes",
      "queryLines": [
        "SELECT verdict, user_status, count(*) AS users\n",
        "FROM silver.users\n",
        "WHERE verdict IS NOT NULL AND user_status IS NOT NULL\n",
        "GROUP BY verdict, user_status\n"
      ]
    },
    {
      "name": "reports_weekly",
      "displayName": "Reports per week",
      "queryLines": [
        "SELECT date_trunc('week', reported_at) AS week, count(*) AS reports\n",
        "FROM silver.report_events\n",
        "GROUP BY week\n"
      ]
    },
    {
      "name": "top_reported_subreddits",
      "displayName": "Top reported subreddits",
      "queryLines": [
        "SELECT subreddit, count(*) AS reports\n",
        "FROM silver.report_events\n",
        "WHERE subreddit IS NOT NULL\n",
        "GROUP BY subreddit\n",
        "ORDER BY reports DESC\n",
        "LIMIT 10\n"
      ]
    }
  ],
  "pages": [
    {
      "name": "overview",
      "displayName": "Overview",
      "layout": [
        {
          "widget": {
            "name": "counter_users_tracked",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "headline_counts",
                  "fields": [{ "name": "users_tracked", "expression": "`users_tracked`" }],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "frame": { "showTitle": true, "title": "Users tracked" },
              "encodings": {
                "value": { "fieldName": "users_tracked", "displayName": "Users tracked" }
              }
            }
          },
          "position": { "x": 0, "y": 0, "width": 2, "height": 3 }
        },
        {
          "widget": {
            "name": "counter_bot_side_verdicts",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "headline_counts",
                  "fields": [{ "name": "bot_side_verdicts", "expression": "`bot_side_verdicts`" }],
                  "disaggregated": true
